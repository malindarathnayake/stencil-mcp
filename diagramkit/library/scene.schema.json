{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stencil scene v1",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "title": {
      "type": "string",
      "maxLength": 160
    },
    "subtitle": {
      "type": "string",
      "maxLength": 300
    },
    "description": {
      "type": "string",
      "maxLength": 1600
    },
    "footer": {
      "type": "string",
      "maxLength": 500
    },
    "width": {
      "type": "integer",
      "minimum": 480,
      "maximum": 6000
    },
    "height": {
      "type": "integer",
      "minimum": 240,
      "maximum": 6000
    },
    "theme": {
      "type": "string",
      "enum": [
        "light",
        "dark",
        "monochrome"
      ]
    },
    "groups": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 6000
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 6000
          },
          "w": {
            "type": "number",
            "minimum": 1,
            "maximum": 6000
          },
          "h": {
            "type": "number",
            "minimum": 1,
            "maximum": 6000
          },
          "title": {
            "type": "string",
            "maxLength": 240
          },
          "caption": {
            "type": "string",
            "maxLength": 240
          },
          "palette": {
            "type": "string",
            "enum": [
              "blue",
              "teal",
              "purple",
              "orange",
              "red",
              "slate",
              "green",
              "yellow"
            ]
          },
          "style": {
            "type": "string",
            "enum": [
              "panel",
              "boundary",
              "lane"
            ]
          }
        },
        "required": [
          "id",
          "x",
          "y",
          "w",
          "h",
          "title"
        ],
        "additionalProperties": false
      }
    },
    "nodes": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "component",
              "symbol",
              "packet",
              "memory",
              "text",
              "marker"
            ]
          },
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 6000
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 6000
          },
          "w": {
            "type": "number",
            "minimum": 1,
            "maximum": 6000
          },
          "h": {
            "type": "number",
            "minimum": 1,
            "maximum": 6000
          },
          "asset": {
            "type": "string",
            "maxLength": 100
          },
          "label": {
            "type": "string",
            "maxLength": 800
          },
          "detail": {
            "type": "string",
            "maxLength": 240
          },
          "caption": {
            "type": "string",
            "maxLength": 120
          },
          "palette": {
            "type": "string",
            "enum": [
              "blue",
              "teal",
              "purple",
              "orange",
              "red",
              "slate",
              "green",
              "yellow"
            ]
          },
          "group": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "font_size": {
            "type": "number",
            "minimum": 10,
            "maximum": 64
          },
          "weight": {
            "type": "integer",
            "enum": [
              400,
              500,
              600,
              700
            ]
          },
          "align": {
            "type": "string",
            "enum": [
              "left",
              "center",
              "right"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "normal",
              "missing",
              "dropped",
              "received",
              "pending",
              "down",
              "blocked"
            ]
          },
          "cells": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string",
                  "maxLength": 30
                },
                "palette": {
                  "type": "string",
                  "enum": [
                    "blue",
                    "teal",
                    "purple",
                    "orange",
                    "red",
                    "slate",
                    "green",
                    "yellow"
                  ]
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "normal",
                    "missing",
                    "received",
                    "dropped",
                    "pending"
                  ]
                }
              },
              "required": [
                "value"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "kind",
          "x",
          "y"
        ],
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 400,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "source": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "target": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "source_port": {
            "type": "string",
            "enum": [
              "n",
              "e",
              "s",
              "w"
            ]
          },
          "target_port": {
            "type": "string",
            "enum": [
              "n",
              "e",
              "s",
              "w"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "data",
              "control",
              "physical",
              "feedback",
              "dependency",
              "tunnel",
              "replication"
            ]
          },
          "palette": {
            "type": "string",
            "enum": [
              "blue",
              "teal",
              "purple",
              "orange",
              "red",
              "slate",
              "green",
              "yellow"
            ]
          },
          "label": {
            "type": "string",
            "maxLength": 160
          },
          "label_x": {
            "type": "number",
            "minimum": 0,
            "maximum": 6000
          },
          "label_y": {
            "type": "number",
            "minimum": 0,
            "maximum": 6000
          },
          "arrow": {
            "type": "string",
            "enum": [
              "forward",
              "both",
              "none"
            ]
          },
          "route": {
            "type": "string",
            "enum": [
              "orthogonal",
              "straight"
            ]
          },
          "points": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 6000
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 6000
                }
              },
              "required": [
                "x",
                "y"
              ],
              "additionalProperties": false
            }
          },
          "width": {
            "type": "number",
            "minimum": 1,
            "maximum": 8
          }
        },
        "required": [
          "id",
          "source",
          "target"
        ],
        "additionalProperties": false
      }
    },
    "legend": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 240
          },
          "palette": {
            "type": "string",
            "enum": [
              "blue",
              "teal",
              "purple",
              "orange",
              "red",
              "slate",
              "green",
              "yellow"
            ]
          },
          "dashed": {
            "type": "boolean"
          }
        },
        "required": [
          "label",
          "palette"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "title",
    "width",
    "height",
    "nodes",
    "edges"
  ],
  "additionalProperties": false
}
